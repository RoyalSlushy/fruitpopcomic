# Copy to .env.local for local development, and set the same values in Vercel.
# .env.local is gitignored. Nothing in this file is a real secret.

# ── public: shipped to the browser ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://rdmxtosklpvwtggakbja.supabase.co

# ── server only: never prefixed NEXT_PUBLIC_ ──────────────────

# Where the server reads and writes. Falls back to NEXT_PUBLIC_SUPABASE_URL,
# but set it explicitly: the public one is inlined at build time, so changing
# it alone would need a rebuild to take effect on the server.
SUPABASE_URL=https://rdmxtosklpvwtggakbja.supabase.co

# Public read key. Server-side only here, so it needs no NEXT_PUBLIC_ prefix.
SUPABASE_ANON_KEY=

# The CMS password. There is no default and no fallback — if this is unset,
# /api/cms/login returns 503 and signing in is impossible.
CMS_ADMIN_PASSWORD=

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also has no fallback; unset means no one can log in.
CMS_SESSION_SECRET=

# Bypasses row level security. `site_content` has no write policies at all,
# so this key is the only thing that can save. Server-side only, always.
SUPABASE_SERVICE_ROLE_KEY=

# Where the voice engine lives. Read-aloud is off — no Listen buttons anywhere,
# no errors — when this is unset, which is a supported state: the site builds
# and serves without it. See docs/tts.md for running services/kokoro.
KOKORO_URL=

# Optional shared secret for that engine. Leave blank on a private network;
# set it (and the same value in the engine's own env) when it is reachable.
KOKORO_TOKEN=
